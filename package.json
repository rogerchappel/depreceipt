{
  "name": "depreceipt",
  "version": "0.1.0",
  "description": "Local-first dependency receipts for noisy lockfile changes.",
  "type": "module",
  "bin": {
    "depreceipt": "./dist/src/cli.js"
  },
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test dist/test/**/*.test.js",
    "smoke": "bash scripts/smoke.sh",
    "prepack": "npm run build",
    "package:smoke": "npm run build && test -f dist/src/cli.js && test -f dist/src/index.js && npm pack --dry-run",
    "release:check": "npm test && npm run smoke && npm run package:smoke"
  },
  "keywords": [
    "dependencies",
    "lockfile",
    "cli",
    "review",
    "receipt"
  ],
  "author": "Roger Chappel",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.8.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/depreceipt.git"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/depreceipt/issues"
  },
  "homepage": "https://github.com/rogerchappel/depreceipt#readme"
}
